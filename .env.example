# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables.
# Every value is optional. With no key, the voice demo uses the offline parser from paper-broker-mcp.

# Either key turns on a real model for the voice demo. Anthropic wins if both are set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (defaults: claude-haiku-5-5, gemini-3.8-flash; Gemini falls back to 3.6-flash, then 3.5-flash-lite).
ANTHROPIC_MODEL=
GEMINI_MODEL=
# low by default; lower is faster for voice.
GEMINI_THINKING_LEVEL=

# Model turns allowed before the demo falls back to the offline parser:
# per visitor per hour, and per day, each counted per server instance.
AGENT_HOURLY_LIMIT=30
AGENT_DAILY_LIMIT=500
